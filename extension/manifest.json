{
  "manifest_version": 3,
  "name": "Radar de Ofertas Tech AR",
  "short_name": "Radar Ofertas",
  "version": "1.2.0",
  "description": "Te avisa de ofertas, cuotas sin interés y eventos en tiendas de tecnología argentinas. Usa la misma base de datos que la página del Radar de Ofertas.",
  "default_locale": "es",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Radar de Ofertas Tech AR",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://tomycampeon1-sketch.github.io/*",
    "https://raw.githubusercontent.com/*",
    "https://*.cetrohogar.com.ar/*",
    "https://*.megatone.net/*",
    "https://api.github.com/*",
    "https://api.mercadolibre.com/*",
    "https://listado.mercadolibre.com.ar/*",
    "https://www.mercadolibre.com.ar/*",
    "https://compragamer.com/*",
    "https://*.compragamer.com/*",
    "https://*.fravega.com/*",
    "https://*.garbarino.com/*",
    "https://*.musimundo.com/*",
    "https://*.mexx.com.ar/*",
    "https://*.venex.com.ar/*",
    "https://*.fullh4rd.com.ar/*",
    "https://*.hotsale.com.ar/*",
    "https://*.cybermonday.com.ar/*"
  ]
}
